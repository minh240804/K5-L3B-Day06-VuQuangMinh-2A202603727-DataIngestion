# Local-only connection for the provided Docker Compose setup.
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab

# Choose ONE provider if you use an API; local embeddings do not need an API key.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_MODEL=

# OpenAI-compatible embedding endpoint used by src/embeddings.py
BASE_URL=https://api.openai.com/v1
BASE_MODEL=text-embedding-3-small

# Optional pipeline paths and chunk parameters
CORPUS_PATH=data/processed/corpus.jsonl
BENCHMARK_PATH=data/question.json
CHROMA_PATH=results/chroma
FIXED_SIZE=1200
FIXED_OVERLAP=150
STRUCTURE_MAX_SIZE=1400
